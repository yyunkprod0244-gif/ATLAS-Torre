# Copie este arquivo para ".env" e preencha para ligar o Jarvis ao Claude.
# Sem isso o site funciona normalmente e o Jarvis responde no modo local.
ANTHROPIC_API_KEY=

# Opcionais:
# JARVIS_MODEL=claude-opus-5-5
# JARVIS_EFFORT=low
# PORT=5173

# Jarvis local: IA e voz no seu computador, sem pagar por pergunta.
# Aponte para a pasta com: llama\llama-server.exe, modelos\*.gguf,
# piper\venv\ (Python com piper-tts) e piper\vozes\*.onnx.
# JARVIS_LOCAL=S:\JarvisLocal
# JARVIS_MOTOR=auto        (auto: Claude se houver chave, senão a IA local · claude · local)
# JARVIS_VOZ=pt_BR-jeff-medium
# JARVIS_GGUF=Qwen3.5-9B-Q4_K_M.gguf   (se houver mais de um modelo na pasta)
# JARVIS_CONTEXTO=16384
